<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Integrious.Umbraco.SaneDatabaseAvailabilityCheck</RootNamespace>
    <AssemblyName>Integrious.Umbraco.SaneDatabaseAvailabilityCheck</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Integrious.Umbraco.SaneDatabaseAvailabilityCheck</PackageId>
    <Title>Sane Database Availability Check for Umbraco</Title>
    <Description>Replaces Umbraco's default boot-time database availability check, which gives up after five attempts over four seconds. This package keeps retrying until the database answers, or until a timeout you configure in appsettings.json is reached. By default it never times out, so a site whose database is slow to start - an Azure SQL serverless database resuming, or a container that outpaced its database - boots successfully instead of failing with a BootFailedException.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-package;database;boot;startup;resilience;retry;azure-sql;serverless</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/Integrious/Umbraco.SaneDatabaseAvailabilityCheck/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco.Cms.Infrastructure is the assembly that declares IDatabaseAvailabilityCheck and
         IUmbracoDatabaseFactory. It is also the NuGet dependency the Umbraco Marketplace reads to
         determine which CMS versions this package supports, hence the explicit major-version range. -->
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.0.0, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrious.Umbraco.SaneDatabaseAvailabilityCheck.Tests" />
  </ItemGroup>

</Project>
